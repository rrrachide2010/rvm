# Chave da Google Places API (New).
# Crie em https://console.cloud.google.com/ > APIs e Servicos > Credenciais.
# Habilite a "Places API (New)" no projeto e restrinja a chave a essa API.
# Copie este arquivo para .env e preencha. O .env NAO vai para o git.
GOOGLE_MAPS_API_KEY=

# Nome e contato de quem assina o relatorio. Aparecem no rodape de cada
# relatorio gerado em out/. Sem eles a ferramenta gera assim mesmo, mas avisa
# antes de voce enviar — o rodape sai com "[defina REMETENTE_NOME no .env]".
REMETENTE_NOME=
REMETENTE_CONTATO=

# Opcional: regiao padrao usada nas buscas.
REGIAO_PADRAO=BR
