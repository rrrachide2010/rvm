{
  "color": {
    "espresso": {
      "$value": "#4a3c3d",
      "$type": "color",
      "$description": "Tom escuro da marca: titulos, simbolo e o preenchimento dos botoes. Com o site em branco, os botoes viraram a unica massa escura da pagina — e e isso que faz o olho achar a acao. 9.99:1 sobre o canvas."
    },
    "tinta": {
      "$value": "#2e2724",
      "$type": "color",
      "$description": "Corpo de texto. Mais escuro que o espresso de proposito: o titulo pesa pelo corpo e pela serifada, o paragrafo pesa pelo contraste. 13.98:1 sobre o canvas."
    },
    "canvas": {
      "$value": "#fbf9f9",
      "$type": "color",
      "$description": "Fundo padrao. Branco com um sopro de rosa — branco puro em tela inteira endurece, e este e o tom que segura o ar da pagina."
    },
    "porcelana": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Superficie elevada: cartoes e blocos que precisam sair do fundo. Branco puro, porque a diferenca para o canvas e o unico relevo que sobrou depois que as faixas escuras sairam."
    },
    "greige": {
      "$value": "#f4efee",
      "$type": "color",
      "$description": "Superficie secundaria: a faixa alternada e a tarja de anuncio. NAO use como texto: da 1.06:1 sobre o canvas. Com o site claro ela deixou de ser cor de texto sobre fundo escuro e virou fundo — e o guarda precisa saber disso."
    },
    "eucalipto": {
      "$value": "#8d5a5e",
      "$type": "color",
      "$description": "Unico acento cromatico: rosa-seco em rotulos, links e acao secundaria. Passa na AA sobre os tres fundos (5.33 no canvas, 5.59 no branco, 4.91 no greige) — por isso este tom e nao um rosa mais claro."
    },
    "areia": {
      "$value": "#e8dedb",
      "$type": "color",
      "$description": "Filete, borda e moldura. NAO use como texto: da 1.26:1 sobre o canvas. O site inteiro se apoia nele para separar secao sem usar bloco pesado."
    }
  },
