{
  "name": "auditoria-clinicas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prospeccao de clinicas de estetica: coleta, auditoria de presenca digital e relatorio de uma pagina.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "buscar": "node --env-file-if-exists=.env src/cli.ts buscar",
    "auditar": "node --env-file-if-exists=.env src/cli.ts auditar",
    "relatorio": "node --env-file-if-exists=.env src/cli.ts relatorio",
    "listar": "node --env-file-if-exists=.env src/cli.ts listar",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "tokens": "node --env-file-if-exists=.env src/tokens.ts",
    "og": "node scripts/og.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
