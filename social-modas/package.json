{
  "name": "social-modas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Site institucional e comercial da Social Modas: Next.js com export estático.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "imagens": "node scripts/imagens.mjs",
    "dev": "npm run imagens && next dev",
    "build": "npm run imagens && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "contraste": "node scripts/contraste.mjs",
    "publicacao": "node scripts/montar-publicacao.mjs",
    "test": "node scripts/fluxos.mjs",
    "verificar": "npm run lint && npm run typecheck && npm run build && npm test && npm run contraste"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.0"
  }
}
